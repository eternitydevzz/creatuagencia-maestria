# Secretos de la Edge Function `generate`. NUNCA van al frontend ni a git.
# En producción se cargan con:  supabase secrets set --env-file supabase/.env.production
ANTHROPIC_API_KEY=sk-ant-...
# Modelo (por defecto claude-opus-5-5). Alternativa más barata: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Refuerzo server-side si el modelo rechaza una petición por seguridad ("off" para desactivarlo)
ANTHROPIC_FALLBACKS=on
# Modelo del agente de WhatsApp (ficha del negocio y chat). Pequeño y rápido: cada mensaje del simulador llama a Claude.
AGENT_MODEL=claude-haiku-4-5-20251001
# Límite de mensajes del chat con el agente por alumno
AGENT_CHAT_PER_MINUTE=20
AGENT_CHAT_PER_HOUR=300
# Máximo de generaciones por alumno y minuto
RATE_LIMIT_PER_MINUTE=10
# Tiempo máximo de una generación, en segundos. Déjalo por debajo del límite de tu plan de Supabase (Free: 150 s, Pro: 400 s).
GENERATION_TIMEOUT_SECONDS=140
# Cada cuántos segundos se manda un latido al navegador mientras Claude trabaja (Supabase corta las conexiones mudas a los 60 s)
HEARTBEAT_SECONDS=8
# SOLO PRUEBAS: apunta a la API simulada (`pnpm mock`) en vez de a Anthropic. Quítalo para usar Claude de verdad.
# ANTHROPIC_BASE_URL=http://host.docker.internal:8787
# Dominio de tu web para CORS en producción (ej. https://app.maestria.com). Por defecto: *
ALLOWED_ORIGIN=*
# SOLO PRUEBAS LOCALES: dominios que la demo desde una URL puede descargar aunque apunten a una IP privada. En producción, déjalo vacío.
# FETCH_ALLOW_HOSTS=host.docker.internal

# --- WhatsApp real (beta) ---
# Servidor WAHA (https://waha.devlike.pro) que mantiene las sesiones de WhatsApp. En local: docker run -p 3000:3000 devlikeapro/waha:noweb
WAHA_URL=https://tu-waha.onrender.com
WAHA_API_KEY=clave-larga-aleatoria
# Dirección pública de la función wa-webhook (a la que WAHA envía los mensajes) y secreto con el que firma el cuerpo (HMAC-SHA512)
WA_WEBHOOK_URL=https://TU-PROYECTO.supabase.co/functions/v1/wa-webhook
WA_WEBHOOK_SECRET=otro-secreto-largo-aleatorio
# Límites (opcionales): números por cuenta, respuestas por día y número, respuestas por hora y chat, espera para agrupar mensajes, horas de pausa si el dueño contesta
# WA_MAX_CONNECTIONS_PER_USER=2
# WA_MAX_REPLIES_PER_DAY=200
# WA_MAX_REPLIES_PER_CHAT_HOUR=30
# WA_DEBOUNCE_MS=2500
# WA_PAUSE_HOURS=6
